// colors.turtle: every kind of word Turtle colors, in one real program.
// Open it in VS Code and change Turtle: Color Scheme to compare schemes;
// run it (turtle colors.turtle) and it checks its own results.
//
// The groups: keywords, imports, functions (bold where defined, a test_
// function bold and italic), data structures, show, text, numbers and
// theories (bold italic, also where a theory's word is used).

//* A block comment
    over two lines. *//

import data
import math
import pattern
import json
import linear
import test
import system
import time [today, format_date]
import lib/bakery_terms

// ---------- data structures, numbers, values ----------
assemble Order [item, qty, cents, paid]

orders = list [Order["rye", 2, 400, true], Order["roll", 12, 50, false], Order["bun", 0, 120, none]]
prices = map ["rye": 400, "roll": 50, "bun": 120]
seen = set ["rye", "roll"]
grid = matrix [1, 2; 3, 4]
half = 0.5
big = 1000000
failures = list []

// ---------- functions ----------
// the cents as dollars: 1250 is "$12.50"
def dollars[cents]
    whole = ~whole_part[cents]
    rest = cents % 100
    if ] rest < 10 [
        return "$" + whole + ".0" + rest
    if [end]
    return "$" + whole + "." + rest
def [end]

def ~whole_part[cents]
    return cents div 100
def [end]

def expect[label, got, want]
    if ] got != want [
        failures at add label + ": got " + got + ", want " + want
    if [end]
def [end]

// A test function: its name is bold and italic.
def test_dollars_pad_cents[]
    check dollars[1205] == "$12.05" .
def [end]

// ---------- a theory, and its word in use ----------
theory total_of
    abstract
        total_of is what the orders os come to, in cents.
    notation total_of os .
    definition
        t = 0
        [loop][o in os]
            t = t + qty of o * cents of o
        [loop][end]
        return t
    theorem result >= 0 || length of os > 0
    proof
        total_of list [Order["a", 2, 300, true]] . is 600
        total_of list [] . is 0
theory [end]

sum_cents is total_of orders .
expect["total", sum_cents, 1400]
expect["dollars", dollars[sum_cents], "$14.00"]
expect["padded", dollars[1205], "$12.05"]

// An imported theory and function.
rye = Loaf["rye", 500, 400]
gram_price is per_gram of rye .
expect["per gram", gram_price, 0.8]
expect["label", label[rye], "rye (500 g)"]

// ---------- keywords, loops, conditions ----------
paid_count = 0
[loop][o in orders]
    if ] paid of o == true [
        paid_count = paid_count + 1
    else if ] paid of o == none [
        continue
    else ]
        warn "not paid yet: ", item of o .
    if [end]
[loop][end]
expect["paid", paid_count, 1]

n = 0
[loop][i = 0; i < 10; i++]
    if ] i == 3 [
        break
    if [end]
    n = n + 1
[loop][end]
expect["loop", n, 3]

// ---------- methods, library functions, sentences ----------
names = orders process o give item of o
expect["names", names, list ["rye", "roll", "bun"]]
big_orders = orders keep o give qty of o > 1
expect["keep", length of big_orders, 2]
expect["upper", "rye" at upper, "RYE"]
expect["round", 2.345 at round[2], 2.35]
expect["range", range[0, 3], list [0, 1, 2]]
expect["seen", seen at contains["rye"], true]
expect["grid", grid at get[1, 0], 3]
expect["price", prices at get["roll"], 50]

// ---------- text ----------
who = "Ann"
greeting = "Hello, {who}!\tWelcome."
expect["text", greeting, "Hello, Ann!\tWelcome."]
single = 'She said "hi" to {who}'
raw = `\d+ stays as typed, {who} too`
expect["single", single, "She said \"hi\" to Ann"]
expect["raw", raw, `\d+ stays as typed, {who} too`]
expect["pattern", findall["a1 b22", `\d+`], list ["1", "22"]]
expect["swap", replaceall["a-b", `(\w)-(\w)`, `$2-$1`], "b-a"]

// ---------- scrolls, safe/handle, diagnose, hypothesis ----------
twice = scroll here * 2 .
expect["scroll", twice[21], 42]
quiet = hypothesis[orders each o give qty of o >= 0]
expect["hypothesis", quiet, true]
safe
    oops = 1 / 0
handle [math] e .
    expect["handled", kind of e, "math"]
safe [end]

// ---------- files and JSON ----------
path = scriptfolder[] + "/colors_out.json"
json_write[path, map ["total": sum_cents, "day": format_date[today[], "YYYY-MM-DD"]]]
back = json_read[path]
expect["json", back at get["total"], 1400]
erase[path]
expect["erased", exists[path], false]

// ---------- the result ----------
[loop][f in failures]
    warn f .
[loop][end]
show "colors.turtle: ", length of failures, " failures" .
if ] length of failures > 0 [
    exit[1]
if [end]
