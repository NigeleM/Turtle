// test_check.turtle: every form of check. Run with: turtle test test_check.turtle
// A check is one fact that must hold; the first one that doesn't fails
// the test and says why.
import test
import sort [is_sorted, min_sort]

assemble Order [item, qty, price]

def total[order]
    return qty of order * price of order
def [end]

// ---------- any true/false value ----------
def test_comparisons[]
    o = Order["pen", 3, 2]
    check total[o] == 6 .
    check total[o] != 7 .
    check total[o] > 5 .
    check total[o] >= 6 && total[o] < 10 .
    check "apple" < "banana" .
def [end]

// Every method and library function that gives true or false works.
def test_methods[]
    nums = list [3, 1, 2]
    check nums at contains[3] .
    check nums at find[2] .
    check nums at index[2] == 2 .
    check !nums at isempty .
    check set [1, 2] at subset[set [1, 2, 3]] .
    check set [1, 2, 3] at superset[set [2]] .
    check "Turtle" at contains["urt"] .
    check "42" at isnumber .
    check is_sorted[min_sort[nums]] .
    check nums at length == 3 && "abc" at length == 3 .
    check map ["a": 1] at length == 1 && set [1, 2] at length == 2 .
    // A method works on the value right before it, like Python's a.invert():
    ages = map ["ann": 30]
    check ages at invert == map [30: "ann"] .
    check ages at invert at invert == ages .
    check "a" + "b" at upper == "aB" .
    check ("a" + "b") at upper == "AB" .
def [end]

// ---------- the kind of a value ----------
def test_kinds[]
    check 5 is integer .
    check 5.0 is float .
    check 5 is number .
    check 2.5 is number .
    check "5" is string .
    check "5" is not number .        // text that looks like a number is still a string
    check true is boolean .
    check list [1] is list .
    check set [1] is set .
    check map ["a": 1] is map .
    check none is none .
    check Order["pen", 1, 2] is Order .
    check total is function .
    check list [] is empty .
    check "" is empty .
    check list [0] is not empty .
def [end]

// ---------- decimals: close to ----------
def test_close[]
    check 0.1 + 0.2 == 0.3 .              // floats compare as they show, to 15 digits
    check 0.1 + 0.2 is close to 0.3 .     // close to: for a bigger allowance
    check 10 / 3 is close to 3.33 within 0.01 .
    check 3.5 is not close to 3 within 0.1 .
def [end]

// ---------- errors: fails ----------
def test_fails[]
    check 1 div 0 fails .                 // any error
    check 1 div 0 fails [math] .          // an error of this kind
    check list [1] at get[5] fails [index] .
    check "a" + list [1] fails [type, math] .
def [end]

// ---------- division ----------
def test_division[]
    check 7 / 2 == 3.5 .
    check 6 / 3 is float .
    check 7 div 2 == 3 .
    check -7 div 2 == -3 .
    check -7 div 2 * 2 + -7 % 2 == -7 .
def [end]
