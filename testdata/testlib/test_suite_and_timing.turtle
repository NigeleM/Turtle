// test_suite_and_timing.turtle: the settings import test makes.
//   suite = false | "stop" | "all"   how the file's tests depend on each other
//   benchmark = false | true         time many runs of each test
//   runs = none | N                  none: as many as fit in benchtime (Go-style)
//   benchtime = 1                    seconds, when runs is none
//   cases = 100                      random inputs each validate tries
//   seed = none                      a number repeats the same random values
// Set them here for every test, or inside one test for just that test.
import test
import sort [min_sort]

suite = "stop"         // a failure would skip the tests after it
cases = 50

// The file's own code runs once, before the tests: shared setup.
prices = list [950, 700, 1225]

def test_setup_is_shared[]
    check length of prices == 3 .
def [end]

def test_benchmark_fixed_runs[]
    benchmark = true
    runs = 20          // exactly 20 timed runs (after one untimed run)
    check min_sort[prices] == list [700, 950, 1225] .
def [end]

def test_benchmark_go_style[]
    benchmark = true
    benchtime = 0.05   // as many runs as fit in a twentieth of a second
    check min_sort[prices] at get[0] == 700 .
def [end]

def test_settings_inside_a_test[]
    cases = 10         // this test only; the file's cases stays 50
    check cases == 10 .
def [end]

def test_file_settings_are_back[]
    check cases == 50 .
def [end]
