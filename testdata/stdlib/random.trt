// random.trt: the random library. Values are random, so the checks are
// about their shape and range, and seed makes a run repeatable.
import random
import search [count_where]
import lib/verify [check, finish]

assemble Order [item, qty, price]

// ---------- simple values stay in their range ----------
rolls = random list of 200 integers from 1 to 6
check["rolls in 1 to 6", count_where[rolls, r give r < 1 || r > 6], 0]
check["every face appears", length of change rolls to set, 6]
prices = random list of 50 floats from 0.5 to 2.5 rounded to 1
check["prices in range", count_where[prices, p give p < 0.5 || p > 2.5], 0]
pin = random digits of 4
check["a pin is 4 characters", length of pin, 4]
code = random string of 6 from "AB"
check["only A and B", count_where[code, c give c != "A" && c != "B"], 0]
days = random list of 30 dates from "2026-02-27" to "2026-03-01"
check["dates across a month end", count_where[days, d give month of d == 2 && day of d < 27], 0]

// ---------- shapes nest ----------
grid = random list of 3 lists of 4 booleans
check["3 rows", length of grid, 3]
check["4 columns", length of grid at get[1], 4]
ages = random map of 5 string of 3 to integer from 0 to 99
check["5 keys", length of ages, 5]
letters = random set of 26 letters
check["a set has different items", length of letters, 26] // every letter, upper or lower
orders = random list of 4 Order [string of 3, integer from 1 to 10, float rounded to 2]
check["assembled values", length of orders, 4]
check["qty in range", count_where[orders, o give qty of o < 1 || qty of o > 10], 0]

// ---------- seed: the same values again ----------
seed = 2026
first = random list of 5 Order [string, integer, float]
seed = 2026
again = random list of 5 Order [string, integer, float]
check["same seed, same values", first == again, true]
seed = none

// ---------- choosing from your own values ----------
deck = list ["A", "K", "Q", "J", "10"]
check["pick is one of them", deck at contains[pick[deck]], true]
check["shuffle keeps every card", change shuffle[deck] to set, change deck to set]
hand = sample[deck, 3]
check["a hand of 3 different cards", length of change hand to set, 3]
check["chance 1 is always", chance[1], true]

finish[]
