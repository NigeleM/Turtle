// log.turtle: the log library. Log lines go to the console (stderr) and,
// with logfile, to a file; outputfile keeps a copy of what show prints.
import log
import system [scriptfolder, erase, exists]
import lib/verify [check, finish]

here = scriptfolder[]
path = "{here}/work_log.log"
copy = "{here}/work_output.txt"
[loop][f in list [path, copy, "{path}.1"]]
    if ] exists[f] [
        erase[f]
    if [end]
[loop][end]

logconsole = false          // keep this example's run quiet
logfile = path
logtime = none              // no time, so the lines can be checked exactly

// ---------- levels: debug < info < warn < error ----------
log "starting" .                       // info
log debug "not shown: below loglevel" .
log warn "disk at ", 91, "%" .
log error "lost connection" .
loglevel = "debug"
log debug "shown now" .
loglevel = "info"

// ---------- fields: a map adds key=value ----------
log info "login", map ["user": "ann", "from": "home office"] .

// ---------- the layout: logparts ----------
logparts = list ["level", "where", "message"]
log info "with the file and line" .
logparts = list ["time", "level", "message"]

// ---------- JSON lines, for other tools ----------
logformat = "json"
log warn "low stock", map ["sku": "B1", "left": 2] .
logformat = "text"

[read] path to lines [end]
check["lines written", length of lines, 7]
check["info", lines at get[0], "INFO  starting"]
check["warn", lines at get[1], "WARN  disk at 91%"]
check["error", lines at get[2], "ERROR lost connection"]
check["debug when loglevel is debug", lines at get[3], "DEBUG shown now"]
check["fields", lines at get[4], "INFO  login user=ann from=\"home office\""]
check["where", lines at get[5], "INFO  log.turtle:34 with the file and line"]
check["json", lines at get[6], "\{\"level\":\"warn\",\"message\":\"low stock\",\"file\":\"log.turtle\",\"line\":39,\"sku\":\"B1\",\"left\":2\}"]

// ---------- a copy of the console: outputfile ----------
outputfile = copy
show "  (this line also goes to work_output.txt)" .
outputfile = none
[read] copy to saved [end]
check["show copied", saved at get[0], "  (this line also goes to work_output.txt)"]

// ---------- rotation: logmaxsize and logkeep ----------
logmaxsize = 40
logkeep = 1
log "this line makes the file pass 40 bytes, so it starts a new one" .
check["rotated", exists["{path}.1"], true]

erase[path]
erase["{path}.1"]
erase[copy]
finish[]
