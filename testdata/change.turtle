// statement form: mutates the variable in place
a = "42"
change a to integer .
show a .
show a + 1 .

f = "3.5"
change f to float .
show f + 1 .

n = 255
change n to string .
show n + "!" .

// expression form: source is untouched, result goes to a new variable
raw = "7"
num = change raw to integer
show raw .
show num + 1 .

// ascii <-> char
code = change "A" to ascii
show code .
letter = change 66 to char
show letter .

// hex <-> integer
h = change 255 to hex
show h .
back = change "ff" to hex
show back .
back2 = change "0xff" to hex
show back2 .

// nested in a larger expression
show change "10" to integer + change "5" to integer .
