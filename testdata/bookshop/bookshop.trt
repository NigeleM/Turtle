// bookshop.trt: a small bookshop app that uses most of Turtle at once,
// and checks its own results. Run it from this folder:
//
//     turtle bookshop.trt
//
// It ends by serving its stock as a web API on port 18123, calling that
// API itself (in the background, with curl), and exiting with the number
// of failed checks: 0 means everything worked together.

import math
import time
import data
import strings
import pattern
import json
import sql
import crypt
import config
import schedule
import sort
import search
import random
import system
import log
import server
import shoplib

failures = list []

def check[label, got, want]
    if ] got != want [
        add label to failures .
        show "  FAIL ", label, ": got ", got, ", want ", want .
    if [end]
def [end]

// ---------- settings: written, then read back (config, TOML) ----------
settings = map [
    "shop": "Turtle Books",
    "opened": make_date[2026, 10, 7],
    "server": map ["port": 18123, "host": "localhost"],
    "staff": list [map ["name": "Ann", "role": "owner"], map ["name": "Bo", "role": "clerk"]]
]
config_write["shop.toml", settings]
conf = config_read["shop.toml"]
check["config round trip", conf == settings, true]
check["config section", port of server of conf, 18123]
check["config staff", name of conf at get["staff"] at get[1], "Bo"]
show "config ok" .

// ---------- stock: raw text through a scroll ----------
raw = "Dune; Frank Herbert; 9.99; 1965
Emma; Jane Austen; 4.50; 1815

Neuromancer; William Gibson; 12.00; 1984
Beloved; Toni Morrison; 11.25; 1987"

books is scroll raw into
    splitby "\n",
    keep line give line at trim != "",
    process line give parsebook[line] .
check["scroll parsed", length of books, 4]
check["assembled field", title of books at get[2], "Neuromancer"]
check["typeof", typeof[books at get[0]], "Book"]

// A saved scroll, reused: prices of modern books, highest first, with tax.
modern = scroll keep b give year of b > 1900, process b give price of b, max_sort, process p give withtax[p] .
prices is scroll books into modern .
check["saved scroll", prices, list [12.96, 12.15, 10.79]]
show "scrolls ok" .

// ---------- closures, recursion, data library ----------
halfoff = discounter[50]
check["closure", halfoff[9.0], 4.5]
check["recursion", fact[5], 120]
total = sum[process[books, b give price of b]]
check["sum", total, 37.74]
total2 = reduce[books, 0, [s, b] give s + price of b]
check["reduce", total2, 37.74]
check["count_where", count_where[books, b give year of b < 1900], 1]
check["range includes its end", range[1, 4], list [1, 2, 3, 4]]
cheapest = find_first[books, b give price of b < 5]
check["search", title of cheapest, "Emma"]
byyear = min_sort[books, b give year of b]
check["sort by key", author of byyear at get[0], "Jane Austen"]
show "functions ok" .

// ---------- loops and conditions ----------
decades = map []
[loop][b in books]
    d = year of b div 10 * 10
    if ] decades at contains[d] [
        decades is decades at add[d, decades at get[d] + 1] .
    else ]
        decades is decades at add[d, 1] .
    if [end]
[loop][end]
check["for-each and map", decades at get[1980], 2]
countdown = list []
[loop][i = 3; i > 0; i--]
    add i to countdown .
[loop][end]
check["C-style loop", countdown, list [3, 2, 1]]
n = 0
[loop][n < 5]
    n = n + 2
[loop][end]
check["while loop", n, 6]
labels = list []
[loop][year, howmany in decades]
    if ] howmany > 1 [
        add "{year}s: {howmany} books" to labels .
    if [end]
[loop][end]
check["map loop and interpolation", labels, list ["1980s: 2 books"]]
show "loops ok" .

// ---------- errors: safe, handle, fail, kinds ----------
safe
    bad = parsebook["just a title"]
handle [custom] e .
    check["fail kind", kind of e, "custom"]
    check["fail message", message of e, "bad book line: just a title"]
safe [end]
safe
    x = books at get[10]
handle [index, key] e .
    check["index error", kind of e, "index"]
safe [end]
safe
    y = change "12x" to integer
handle [number] e .
    check["number error", kind of e, "number"]
safe [end]
show "errors ok" .

// ---------- diagnose: tracing a scroll that goes wrong ----------
def lookup[t]
    return find_first[books, b give title of b == t]
def [end]
res = diagnose[scroll "Missing Book" into lookup, here at get[0] .]
check["diagnose gives the error", kind of res, "type"]
fine = diagnose[scroll "Dune" into lookup, price of here .]
check["diagnose gives the result", fine, 9.99]
show "diagnose ok" .

// ---------- time zones ----------
order = make_date[2026, 12, 24, 18, 0, 0, "Asia/Tokyo"]
shipped = order to_zone "America/New_York"
check["same moment", shipped == order, true]
check["new york clock", hour of shipped, 4]
check["zone part", zone of shipped, "America/New_York"]
due = add_time[order, 3, "days"]
check["date math", time_between[order, due, "hours"], 72]
check["format", format_date[shipped, "DD Mon hh:mm Zone"], "24 Dec 04:00 EST"]
show "time zones ok" .

// ---------- JSON, crypt, patterns ----------
catalog = json_text[process[books, b give map ["title": title of b, "price": price of b]]]
back = load[catalog]
check["json round trip", price of back at get[3], 11.25]
check["hash", hash["Dune"], hash["Dune"]]
box = encrypt[catalog, "s3cret"]
check["encrypt round trip", decrypt[box, "s3cret"] == catalog, true]
years = findall[raw, `\d{4}`]
check["pattern findall", years, list ["1965", "1815", "1984", "1987"]]
check["replaceall", replaceall["a-b-c", "-", "+"], "a+b+c"]
show "json, crypt, patterns ok" .

// ---------- SQLite ----------
safe
    erase["shop.db"]
handle [file] e .
safe [end]
db = sql_create["shop.db"]
sql_run[db, "CREATE TABLE books (title TEXT PRIMARY KEY, author TEXT, price REAL, year INTEGER)"]
[loop][b in books]
    sql_run[db, "INSERT INTO books VALUES (?, ?, ?, ?)", list [title of b, author of b, price of b, year of b]]
[loop][end]
rows = sql_query[db, "SELECT title FROM books WHERE price > ? ORDER BY price DESC", list [10]]
check["sql query", process[rows, r give title of r], list ["Neuromancer", "Beloved"]]
sql_close[db]
show "sql ok" .

// ---------- files, log, random, schedule ----------
[write] report.txt
"Turtle Books report"
catalog
[end]
[read] report.txt to lines [end]
check["file round trip", lines at get[0], "Turtle Books report"]
logfile = "shop.log"
logconsole = false
log "report written" .
[read] shop.log to loglines [end]
check["log file", loglines at get[0] at contains["report written"], true]
erase["shop.log"]
seed = 7
first = random list of 3 integers from 1 to 100
seed = 7
second = random list of 3 integers from 1 to 100
check["seeded random repeats", first, second]
outs = runall[list ["echo one", "echo two"]]
check["runall", process[outs, o give output of o], list ["one", "two"]]
show "files, log, random, schedule ok" .

// ---------- the web API: serve, call it, check, exit ----------
def stock[req]
    return process[books, b give map ["title": title of b, "price": price of b]]
def [end]
def onebook[req]
    i = change id of params of req to integer
    safe
        b = books at get[i]
    handle [index] e .
        return reply[404, "no book " + i]
    safe [end]
    return map ["title": title of b, "author": author of b]
def [end]
def finish[req]
    [read] api.txt to got [end]
    check["api stock", load[got at get[0]] at len, 4]
    check["api one book", author of load[got at get[1]], "Toni Morrison"]
    check["api 404", got at get[2], "404"]
    erase["api.txt"]
    erase["shop.toml"]
    erase["shop.db"]
    erase["report.txt"]
    show "server ok" .
    show length of failures, " failed" .
    exit[length of failures]
def [end]
app = map ["GET /books": stock, "GET /books/:id": onebook, "GET /finish": finish]
serverlog = false
sys (sleep 1; (curl -s localhost:18123/books; echo; curl -s localhost:18123/books/3; echo; curl -s -o /dev/null -w '%{http_code}' localhost:18123/books/9; echo) > api.txt; curl -s localhost:18123/finish > /dev/null) > /dev/null 2>&1 &
serve[app, port of server of conf]
