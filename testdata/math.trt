// Math methods on numbers require "import math" first.
import math

r is 16 at sqrt .
show r .

a is -7 at abs .
show a .
b is -7.5 at abs .
show b .

r2 is 4.5 at round .
show r2 .
r3 is 4.5 at floor .
show r3 .
r4 is 4.1 at ceil .
show r4 .

p is 2 at pow 10 .
show p .

// random's range is [0, n)
n is 10 at random .
inRange = n >= 0 && n < 10
show inRange .

show 10 % 3 .
show 10.5 % 3 .
