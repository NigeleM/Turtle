// housing.trt: a small housing-market study with the data library's
// statistics and the linear library. It writes a table of sales, reads
// it back, describes the prices, fits a price model by least squares,
// finds the main directions in the data (PCA), forecasts the market with
// a Markov chain and plans a renovation budget, checking each answer
// against one worked out exactly (with fractions, in Python).
// Run it from this folder:
//
//     turtle housing.trt
//
// It exits with the number of failed checks: 0 means everything worked.

import data
import linear
import math
import system

failures = list []

def near[label, got, want]
    gap = got - want
    allowed = want at abs + 1
    if ] gap at abs > allowed * 1e-9 [
        add label to failures .
        show "  FAIL ", label, ": got ", got, ", want ", want .
    if [end]
def [end]

def same[label, got, want]
    if ] got != want [
        add label to failures .
        show "  FAIL ", label, ": got ", got, ", want ", want .
    if [end]
def [end]

// ---------- the sales, to a file and back ----------
sales = list [
    map ["size": 52, "rooms": 2, "age": 30, "price": 182],
    map ["size": 61, "rooms": 2, "age": 12, "price": 231],
    map ["size": 75, "rooms": 3, "age": 25, "price": 248],
    map ["size": 80, "rooms": 3, "age": 5, "price": 301],
    map ["size": 95, "rooms": 4, "age": 40, "price": 290],
    map ["size": 102, "rooms": 4, "age": 8, "price": 365],
    map ["size": 110, "rooms": 4, "age": 15, "price": 372],
    map ["size": 120, "rooms": 5, "age": 22, "price": 398],
    map ["size": 135, "rooms": 5, "age": 3, "price": 470],
    map ["size": 150, "rooms": 6, "age": 35, "price": 452],
    map ["size": 68, "rooms": 3, "age": 18, "price": 229],
    map ["size": 88, "rooms": 3, "age": 10, "price": 309]
]
table_write["houses.csv", sales]
houses = table_read["houses.csv"]   // unquoted numbers come back as numbers
erase["houses.csv"]
same["rows read back", length of houses, 12]

// ---------- describing the prices ----------
show "Prices (thousands):" .
show table[describe[houses, "price"]] .
near["mean price", mean[houses, "price"], 320.5833333333333]
near["median price", median[houses, "price"], 305]
near["stdev price", stdev[houses, "price"], 91.72335712578472]
near["90th percentile", percentile[houses, "price", 90], 446.6]
r = correlation[houses, "size", "price"]
near["size and price move together", r, 0.9739665276399652]
show "correlation of size and price: ", r at round[3] .

// ---------- a price model: price = b0 + b1 size + b2 rooms + b3 age ----------
design = houses process h give list [1, size of h, rooms of h, age of h]
x = change design to matrix
prices = column[change houses to matrix, 3]
beta = least_squares[x, prices]
near["intercept", beta at get[0], 67.39076220190674]
near["per square metre", beta at get[1], 3.05782994217101]
near["per room", beta at get[2], -1.6179855441700812]
near["per year of age", beta at get[3], -1.6331506582316802]

fitted = x * beta
mean_price = mean[prices]
ss_res = 0
ss_tot = 0
[loop][i in range[length of prices]]
    p = prices at get[i]
    miss = p - fitted at get i
    spread = p - mean_price
    ss_res = ss_res + miss at pow 2
    ss_tot = ss_tot + spread at pow 2
[loop][end]
r2 = 1 - ss_res / ss_tot
near["R squared", r2, 0.9954381014441794]
// The same fit by the normal equations, solved directly.
again = solve[transpose[x] * x, transpose[x] * prices]
[loop][i in range[4]]
    near["normal equations " + i, again at get[i], beta at get[i]]
[loop][end]
new_house = list [1, 100, 4, 10]
guess = dot[new_house, beta]
near["a new 100 m2 house", guess, 350.3703076600106]
show "a 100 m2, 4-room, 10-year-old house: about ", guess at round[1], "k (R2 ", r2 at round[4], ")" .

// ---------- the main directions in the data (PCA) ----------
features = list ["size", "rooms", "age"]
standard = list []
[loop][f in features]
    add zscores[houses, f] to standard .
[loop][end]
z = transpose[change standard to matrix]
n_less_one = length of houses - 1
corr = transpose[z] * z / n_less_one
pca = eigen[corr]
values = pca at get["values"]
near["eigenvalues add up to the trace", sum[values], trace[corr]]
vectors = pca at get["vectors"]
same["the directions are at right angles", transpose[vectors] * vectors, identity[3]]
same["corr times a direction stretches it", corr * vectors, vectors * diagonal[values]]
share = values at get[0] / sum[values]
percent = share * 100
show "the first direction explains ", percent at round[1], "% of the variation" .
if ] share < 0.5 [
    add "first component" to failures .
if [end]

// ---------- the market as a Markov chain ----------
// From each month's state (buyer's, balanced, seller's) to the next.
moves = matrix [
    0.7, 0.2, 0.1
    0.3, 0.4, 0.3
    0.1, 0.3, 0.6
]
[loop][i in range[3]]
    near["row " + i + " adds to 1", sum[moves at row[i]], 1]
[loop][end]
today = list [0, 0, 1]
later = today * power[moves, 60]
// The long-run share solves: share * moves == share, and the shares add to 1.
system_of = transpose[moves] - identity[3]
put 1 to system_of at 2, 0 .               // the sentence form ...
system_of at put[1, 2, 1]                   // ... and the method form, on its own line
system_of at put 1, 2, 2 .
steady = solve[system_of, list [0, 0, 1]]
near["long run: buyer's", steady at get[0], 15 / 38]
near["long run: balanced", steady at get[1], 11 / 38]
near["long run: seller's", steady at get[2], 6 / 19]
[loop][i in range[3]]
    near["60 months on, state " + i, later at get[i], steady at get[i]]
[loop][end]
buyers = steady at get[0] * 100
sellers = steady at get[2] * 100
show "long run: ", buyers at round[1], "% buyer's, ", sellers at round[1], "% seller's" .

// ---------- a renovation budget ----------
// Kitchens, bathrooms and paint jobs: hours, jobs and materials.
work = matrix [
    2, 3, 1
    1, 1, 1
    4, 1, 2
]
plan = solve[work, list [23, 10, 21]]
same["renovation plan", plan, list [3, 5, 2]]
same["the plan fits", work * plan, list [23, 10, 21]]
same["determinant", determinant[work], 5]

// ---------- the result ----------
if ] length of failures == 0 [
    show "housing: all checks passed" .
else ]
    show "housing: ", length of failures, " checks failed" .
if [end]
exit[length of failures]
