// 14_typed_load.turtle: column types for files. A map of column name to type
// after the file makes table_read and sql_load read each column as the
// right kind of value, so "007" stays text and "24" becomes a number.
// sql_load makes the table when it isn't there; "primary_key" names its
// key. Types are Turtle words (string, text, integer, float, boolean,
// date) or SQL ones (VARCHAR(10), NUMERIC(4, 2), ...).
import sql
import data
import system [scriptfolder, erase, exists]
import lib/verify [check, finish]

here = scriptfolder[]
agents = "{here}/data/agents.csv"
path = "{here}/work14.db"
if ] exists[path] [
    erase[path]
if [end]

// ---------- table_read: without types, an unquoted number is a number ----------
plain = table_read[agents]
check["plain: a number", plain at get[0] at get["missions"], 24]
check["plain: 007 stays text", plain at get[0] at get["code"], "007"]

// The map can be written in place or kept in a variable.
types = map ["code": "text", "missions": "integer", "rating": "float", "active": "boolean", "joined": "date", "primary_key": "code"]
rows = table_read[agents, types]
show table[rows] .
check["code stays text", rows at get[0] at get["code"], "007"]
check["0042 keeps its zeros", rows at get[2] at get["code"], "0042"]
check["integer", rows at get[0] at get["missions"], 24]
check["float", rows at get[1] at get["rating"], 7.25]
check["empty cell is none", rows at get[2] at get["rating"], none]
check["yes is true", rows at get[0] at get["active"], true]
check["no is false", rows at get[1] at get["active"], false]
joined = rows at get[0] at get["joined"]
check["date", year of joined, 1953]
// Columns the map leaves out stay text.
check["name is text", rows at get[0] at get["name"], "James Bond"]

// Computing needs no change ... to ... now.
total = 0
[loop][r in rows]
    total = total + missions of r
[loop][end]
check["missions added up", total, 27]

// ---------- sql_load makes the table from the map ----------
db = sql_create[path]
check["loaded", sql_load[db, "agents", agents, types], 3]
made = sql_query[db, "SELECT sql FROM sqlite_schema WHERE name = 'agents'"]
show made at get[0] at get["sql"] .
check["the table it made", made at get[0] at get["sql"], "CREATE TABLE \"agents\" (\"code\" TEXT PRIMARY KEY, \"name\" TEXT, \"missions\" INTEGER, \"rating\" REAL, \"active\" BOOLEAN, \"joined\" DATE)"]
back = sql_query[db, "SELECT code, missions, typeof(missions) AS t, joined FROM agents ORDER BY code"]
show table[back] .
check["text key kept", back at get[0] at get["code"], "0042"]
check["missions stored as a number", back at get[0] at get["t"], "integer"]
check["date stored as the day", back at get[2] at get["joined"], "1953-04-13"]

// The key is a real PRIMARY KEY: loading the same file again is refused,
// and (all or nothing) adds nothing.
refused = false
safe
    sql_load[db, "agents", agents, types]
handle [sql] e .
    refused = true
safe [end]
check["duplicate keys refused", refused, true]
check["still 3", sql_query[db, "SELECT count(*) AS n FROM agents"], list [map ["n": 3]]]

// ---------- no map: a new table's columns follow the file ----------
check["loaded without a map", sql_load[db, "agents_plain", agents], 3]
t = sql_query[db, "SELECT missions, typeof(missions) AS t FROM agents_plain WHERE code = '007'"]
check["numbers make a number column", t, list [map ["missions": 24, "t": "integer"]]]

// ---------- SQL type words, and an existing table ----------
sqltypes = map ["code": "VARCHAR(10)", "missions": "SMALLINT", "rating": "NUMERIC(4, 2)"]
sql_load[db, "agents_sql", agents, sqltypes]
made = sql_query[db, "SELECT sql FROM sqlite_schema WHERE name = 'agents_sql'"]
check["SQL words kept", made at get[0] at get["sql"], "CREATE TABLE \"agents_sql\" (\"code\" VARCHAR(10), \"name\" TEXT, \"missions\" SMALLINT, \"rating\" NUMERIC(4, 2), \"active\" TEXT, \"joined\" TEXT)"]
// The table is there now, so this adds rows; the map still converts.
check["added to it", sql_load[db, "agents_sql", agents, sqltypes], 3]

// ---------- mistakes are errors, and change nothing ----------
def error_of[f]
    message = ""
    safe
        f[none]
    handle [] e .
        message = "{kind of e}: {message of e}"
    safe [end]
    return message
def [end]
bad = error_of[x give table_read[agents, map ["missions": "integer", "name": "integer"]]]
show bad .
check["a value that isn't its type", bad at contains["row 1, column \"name\": \"James Bond\" isn't an integer"], true]
check["number error", bad at slice[0, 6], "number"]
bad = error_of[x give table_read[agents, map ["mission": "integer"]]]
check["a column the file lacks", bad at contains["no column \"mission\""], true]
bad = error_of[x give table_read[agents, map ["code": "words"]]]
check["an unknown type", bad at contains["isn't a type for column"], true]
bad = error_of[x give table_read[agents, map ["active": "boolean", "primary_key": "active"]]]
check["a key that repeats", bad at contains["the same \"active\""], true]
bad = error_of[x give sql_load[db, "agents_bad", agents, map ["joined": "integer"]]]
check["sql_load converts first", bad at contains["isn't an integer"], true]
check["no table left behind", sql_tables[db] at contains["agents_bad"], false]

sql_close[db]
erase[path]
finish[]
