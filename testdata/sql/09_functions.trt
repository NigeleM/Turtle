// 09_functions.trt: SQL's own functions: text, numbers, dates, CASE,
// CAST, COALESCE, printf.
import sql
import data
import system [scriptFolder]
import lib/verify [check, finish]
import lib/shop [make_shop, drop_shop]

path = "{scriptFolder[]}/work09.db"
db = make_shop[path]

def one[db, q]
    rows = sql_query[db, q]
    return rows at get[0]
def [end]

// ---------- text ----------
r = one[db, "SELECT upper(title) AS u, length(title) AS n, substr(title, 1, 3) AS s, replace(title, ' ', '_') AS r, instr(title, 'and') AS i FROM books WHERE sku = 'B6'"]
check["text", r, map ["u": "PRIDE AND PREJUDICE", "n": 19, "s": "Pri", "r": "Pride_and_Prejudice", "i": 7]]
r = one[db, "SELECT trim('  x  ') AS t, 'a' || 'b' || 1 AS c, title LIKE 'p%' AS l, title GLOB 'P*' AS g FROM books WHERE sku = 'B6'"]
check["more text", r, map ["t": "x", "c": "ab1", "l": 1, "g": 1]]

// ---------- numbers ----------
r = one[db, "SELECT 7 / 2 AS div, 7.0 / 2 AS real, 7 % 3 AS mod, round(2.567, 2) AS r, abs(-4) AS a, max(3, 9, 4) AS m, 10 / 0 AS zero"]
check["numbers", r, map ["div": 3, "real": 3.5, "mod": 1, "r": 2.57, "a": 4, "m": 9, "zero": none]]
r = one[db, "SELECT printf('%.2f', price / 100.0) AS dollars, printf('%05d', stock) AS padded, printf('%,d', 1234567) AS big FROM books WHERE sku = 'B2'"]
check["printf", r, map ["dollars": "12.25", "padded": "00000", "big": "1,234,567"]]

// ---------- dates ----------
r = one[db, "SELECT date('2026-01-31', '+1 month') AS a, date('2026-10-05', 'start of month') AS b, date('2026-10-05', 'weekday 0') AS c, strftime('%d/%m/%Y', '2026-10-05') AS d"]
check["dates", r, map ["a": "2026-03-03", "b": "2026-10-01", "c": "2026-10-11", "d": "05/10/2026"]]
r = one[db, "SELECT julianday('2026-12-25') - julianday('2026-10-05') AS days, unixepoch('2026-01-01') AS secs, datetime('2026-10-05 14:30', '+90 minutes') AS later"]
check["date math", r, map ["days": 81.0, "secs": 1767225600, "later": "2026-10-05 16:00:00"]]
rows = sql_query[db, "SELECT title, CAST(strftime('%Y', published) AS INTEGER) AS year FROM books WHERE published < '1900' ORDER BY published"]
show table[rows] .
check["years", rows at get[0], map ["title": "Pride and Prejudice", "year": 1813]]

// ---------- CASE, COALESCE, CAST, IIF ----------
rows = sql_query[db, "SELECT title, CASE WHEN stock = 0 THEN 'sold out' WHEN stock < 3 THEN 'low' ELSE 'ok' END AS status FROM books ORDER BY stock, title"]
show table[rows] .
check["case", rows at get[0], map ["title": "Gone Girl", "status": "sold out"]]
r = one[db, "SELECT coalesce(NULL, NULL, 'third') AS c, CAST('42abc' AS INTEGER) AS i, CAST(3 AS TEXT) || '!' AS t, iif(1 > 2, 'yes', 'no') AS f, nullif(5, 5) AS n"]
check["coalesce cast iif", r, map ["c": "third", "i": 42, "t": "3!", "f": "no", "n": none]]

drop_shop[db, path]
finish[]
