// 13_servers.trt: the same sql functions on PostgreSQL and MySQL servers.
// sql_open takes a server address instead of a file; everything else is
// unchanged. Set TURTLE_PG_URL and/or TURTLE_MYSQL_URL to run it, e.g.
//   TURTLE_PG_URL=postgres://turtle:turtlepw@localhost:55432/turtle
//   TURTLE_MYSQL_URL=mysql://turtle:turtlepw@localhost:53306/turtle
// Without either, it only says so.
import sql
import data
import system [scriptfolder, erase, env]
import lib/verify [check, finish]

here = scriptfolder[]

def price_of[db, sku]
    rows = sql_query[db, "SELECT price FROM turtle_books WHERE sku = ?", list [sku]]
    if ] length of rows == 0 [
        return none
    if [end]
    return rows at get[0] at get["price"]
def [end]

def count_of[db]
    rows = sql_query[db, "SELECT count(*) AS n FROM turtle_books"]
    return rows at get[0] at get["n"]
def [end]

def exercise[db, kind]
    show "---------- ", kind, " ----------" .
    sql_run[db, "DROP TABLE IF EXISTS turtle_books"]
    sql_run[db, "DROP TABLE IF EXISTS turtle_authors"]
    sql_run[db, "CREATE TABLE turtle_authors (id INTEGER PRIMARY KEY, name VARCHAR(100) NOT NULL UNIQUE, country VARCHAR(2))"]
    sql_run[db, "CREATE TABLE turtle_books (sku VARCHAR(10) PRIMARY KEY, title VARCHAR(100) NOT NULL, author_id INTEGER REFERENCES turtle_authors (id), price INTEGER NOT NULL CHECK (price > 0), stock INTEGER NOT NULL DEFAULT 0, published DATE)"]
    check["{kind}: tables", sql_tables[db] at index["turtle_books"] >= 0, true]

    // ---------- files in: the same CSV files as 11_csv_import.trt ----------
    check["{kind}: authors loaded", sql_load[db, "turtle_authors", "{here}/data/authors.csv"], 5]
    check["{kind}: books loaded", sql_load[db, "turtle_books", "{here}/data/books.csv"], 6]
    check["{kind}: prices changed", sql_update[db, "turtle_books", "sku", "{here}/data/price_changes.csv"], 2]
    check["{kind}: B1 new price", price_of[db, "B1"], 999]
    check["{kind}: deleted", sql_delete[db, "turtle_books", "sku", "{here}/data/discontinued.csv"], 2]
    check["{kind}: books left", count_of[db], 4]

    // upsert: B1 is there (new price), B7 is new.
    restock = "{here}/restock_{kind}.csv"
    table_write[restock, list [map ["sku": "B1", "title": "Dune", "author_id": 1, "price": 1050, "stock": 10], map ["sku": "B7", "title": "Beloved", "author_id": 5, "price": 1100, "stock": 3]]]
    check["{kind}: upserted", sql_upsert[db, "turtle_books", "sku", restock], 2]
    check["{kind}: B1 changed by upsert", price_of[db, "B1"], 1050]
    check["{kind}: B7 added by upsert", price_of[db, "B7"], 1100]
    check["{kind}: upsert again changes nothing new", sql_upsert[db, "turtle_books", "sku", restock], 2]
    check["{kind}: still 5 books", count_of[db], 5]
    erase[restock]

    // A bad file changes nothing: B4's new price 0 breaks the CHECK.
    refused = false
    safe
        sql_update[db, "turtle_books", "sku", "{here}/data/bad_prices.csv"]
    handle [sql] e .
        refused = true
    safe [end]
    check["{kind}: bad file refused", refused, true]
    check["{kind}: B3 kept its price", price_of[db, "B3"], 850]

    // ---------- queries: values, joins, grouping, dates ----------
    rows = sql_query[db, "SELECT b.title, a.name FROM turtle_books b JOIN turtle_authors a ON a.id = b.author_id WHERE b.price < ? ORDER BY b.title", list [900]]
    show table[rows] .
    check["{kind}: join with a value", rows at get[0], map ["title": "Emma", "name": "Jane Austen"]]
    rows = sql_query[db, "SELECT author_id, count(*) AS n FROM turtle_books GROUP BY author_id HAVING count(*) > 1 ORDER BY author_id"]
    check["{kind}: group by", rows, list [map ["author_id": 3, "n": 2]]]
    rows = sql_query[db, "SELECT published FROM turtle_books WHERE sku = 'B1'"]
    published = rows at get[0] at get["published"]
    check["{kind}: a DATE comes back as a date", "{published}", "1965-08-01 00:00:00"]
    rows = sql_query[db, "SELECT title FROM turtle_books WHERE published IS NULL"]
    check["{kind}: empty cell is NULL", rows, list [map ["title": "Beloved"]]]

    // ---------- changes, transactions, errors ----------
    check["{kind}: update count", sql_run[db, "UPDATE turtle_books SET stock = stock + ? WHERE author_id = ?", list [1, 3]], 2]
    sql_run[db, "BEGIN"]
    sql_run[db, "DELETE FROM turtle_books"]
    sql_run[db, "ROLLBACK"]
    check["{kind}: rollback kept the books", count_of[db], 5]
    message = ""
    safe
        sql_run[db, "INSERT INTO turtle_books (sku, title, price) VALUES (?, ?, ?)", list ["B1", "Again", 5]]
    handle [sql] e .
        message = message of e
    safe [end]
    check["{kind}: duplicate key refused", message != "", true]
    show "  refused: ", message .

    // ---------- files out ----------
    out = "{here}/export_{kind}.csv"
    check["{kind}: saved", sql_save[db, "SELECT sku, title, price FROM turtle_books ORDER BY sku", out], 5]
    check["{kind}: saved file", table_read[out] at get[0], map ["sku": "B1", "title": "Dune", "price": 1050]]
    erase[out]

    // ---------- column types: sql_load makes the table ----------
    sql_run[db, "DROP TABLE IF EXISTS turtle_agents"]
    types = map ["code": "text", "missions": "integer", "rating": "float", "active": "boolean", "joined": "date", "primary_key": "code"]
    check["{kind}: typed load", sql_load[db, "turtle_agents", "{here}/data/agents.csv", types], 3]
    rows = sql_query[db, "SELECT code, missions, rating, active, joined FROM turtle_agents ORDER BY code"]
    show table[rows] .
    check["{kind}: text key kept", rows at get[2] at get["code"], "007"]
    check["{kind}: integer", rows at get[2] at get["missions"], 24]
    check["{kind}: float", rows at get[1] at get["rating"], 7.25]
    check["{kind}: none", rows at get[0] at get["rating"], none]
    joined = rows at get[2] at get["joined"]
    check["{kind}: date", year of joined, 1953]
    refused = false
    safe
        sql_load[db, "turtle_agents", "{here}/data/agents.csv", types]
    handle [sql] e .
        refused = true
    safe [end]
    check["{kind}: the key is a primary key", refused, true]
    sql_run[db, "DROP TABLE turtle_agents"]

    sql_run[db, "DROP TABLE turtle_books"]
    sql_run[db, "DROP TABLE turtle_authors"]
    sql_close[db]
def [end]

ran = 0
pg = env["TURTLE_PG_URL"]
if ] pg != none [
    exercise[sql_open[pg], "postgres"]
    ran = ran + 1
if [end]
my = env["TURTLE_MYSQL_URL"]
if ] my != none [
    exercise[sql_open[my], "mysql"]
    ran = ran + 1
if [end]
if ] ran == 0 [
    show "no server: set TURTLE_PG_URL or TURTLE_MYSQL_URL to run this" .
if [end]
finish[]
