// 07_transactions.trt: BEGIN ... COMMIT saves several changes together;
// ROLLBACK throws them all away. A program that stops before COMMIT
// leaves the file as it was.
import sql
import data
import system [scriptfolder]
import lib/verify [check, finish]
import lib/shop [make_shop, drop_shop]

path = "{scriptfolder[]}/work07.db"
db = make_shop[path]

def stock_of[db, sku]
    rows = sql_query[db, "SELECT stock FROM books WHERE sku = ?", list [sku]]
    return rows at get[0] at get["stock"]
def [end]

// ---------- move stock between two books: both changes or neither ----------
def move_stock[db, giver, taker, n]
    sql_run[db, "BEGIN"]
    safe
        sql_run[db, "UPDATE books SET stock = stock + ? WHERE sku = ?", list [n, taker]]
        sql_run[db, "UPDATE books SET stock = stock - ? WHERE sku = ?", list [n, giver]]
        left = stock_of[db, giver]
        if ] left < 0 [
            fail "not enough stock in {giver}"
        if [end]
        sql_run[db, "COMMIT"]
        return true
    handle [] e .
        sql_run[db, "ROLLBACK"]
        return false
    safe [end]
def [end]

check["B6 to B1, 3 copies", move_stock[db, "B6", "B1", 3], true]
check["B1 now", stock_of[db, "B1"], 7]
check["B6 now", stock_of[db, "B6"], 6]
check["too many: refused", move_stock[db, "B4", "B1", 50], false]
check["B1 unchanged", stock_of[db, "B1"], 7]
check["B4 unchanged", stock_of[db, "B4"], 2]

// ---------- ROLLBACK ----------
sql_run[db, "BEGIN"]
sql_run[db, "DELETE FROM sales"]
check["inside: gone", sql_query[db, "SELECT count(*) AS n FROM sales"], list [map ["n": 0]]]
sql_run[db, "ROLLBACK"]
check["after rollback: back", sql_query[db, "SELECT count(*) AS n FROM sales"], list [map ["n": 8]]]

// ---------- many rows in one transaction ----------
// Each statement on its own waits for the disk; inside BEGIN ... COMMIT
// the disk is written once.
sql_run[db, "BEGIN"]
[loop][i = 0; i < 500; i++]
    sql_run[db, "INSERT INTO sales (sku, day, qty, region) VALUES ('B3', '2026-10-02', 1, 'web')"]
[loop][end]
sql_run[db, "COMMIT"]
check["500 web sales", sql_query[db, "SELECT count(*) AS n FROM sales WHERE region = 'web'"], list [map ["n": 500]]]

// ---------- an error inside a transaction keeps it open ----------
sql_run[db, "BEGIN"]
sql_run[db, "INSERT INTO authors (name) VALUES ('Ursula K. Le Guin')"]
safe
    sql_run[db, "INSERT INTO authors (name) VALUES ('Jane Austen')"]
handle [sql] e .
safe [end]
sql_run[db, "COMMIT"]
check["the good insert was kept", sql_query[db, "SELECT count(*) AS n FROM authors"], list [map ["n": 6]]]

drop_shop[db, path]
finish[]
