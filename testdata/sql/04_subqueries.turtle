// 04_subqueries.turtle: queries inside queries, UNION / INTERSECT / EXCEPT,
// WITH tables (also recursive), and VALUES.
import sql
import data
import system [scriptfolder]
import lib/verify [check, finish]
import lib/shop [make_shop, drop_shop]

path = "{scriptfolder[]}/work04.db"
db = make_shop[path]

// ---------- a subquery as a value ----------
rows = sql_query[db, "SELECT title, price FROM books WHERE price > (SELECT avg(price) FROM books) ORDER BY price DESC"]
show table[rows] .
check["above average", length of rows, 2]

// ---------- IN (SELECT ...) and NOT IN ----------
rows = sql_query[db, "SELECT title FROM books WHERE sku IN (SELECT sku FROM sales WHERE region = 'east') ORDER BY title"]
check["sold in the east", rows, list [map ["title": "Dune"], map ["title": "Emma"]]]
rows = sql_query[db, "SELECT name FROM authors WHERE id NOT IN (SELECT author_id FROM books)"]
check["not in", rows, list [map ["name": "Toni Morrison"]]]

// ---------- EXISTS, with a correlated subquery ----------
rows = sql_query[db, "SELECT a.name FROM authors a WHERE EXISTS (SELECT 1 FROM books b WHERE b.author_id = a.id AND b.price < 700) ORDER BY a.name"]
check["exists", rows, list [map ["name": "Isaac Asimov"], map ["name": "Jane Austen"]]]

// ---------- a subquery per row ----------
rows = sql_query[db, "SELECT name, (SELECT count(*) FROM books b WHERE b.author_id = a.id) AS books FROM authors a ORDER BY books DESC, name LIMIT 2"]
show table[rows] .
check["per row", rows at get[0], map ["name": "Isaac Asimov", "books": 2]]

// ---------- a subquery as a table ----------
rows = sql_query[db, "SELECT t.region, t.copies FROM (SELECT region, sum(qty) AS copies FROM sales GROUP BY region) AS t WHERE t.copies > 4 ORDER BY t.region"]
check["derived table", rows, list [map ["region": "east", "copies": 6], map ["region": "north", "copies": 10]]]

// ---------- UNION, INTERSECT, EXCEPT ----------
rows = sql_query[db, "SELECT country AS place FROM authors UNION SELECT region FROM sales ORDER BY 1"]
check["union", length of rows, 6]
rows = sql_query[db, "SELECT sku FROM books EXCEPT SELECT sku FROM sales"]
check["except", rows, list [map ["sku": "B2"]]]
rows = sql_query[db, "SELECT sku FROM sales WHERE region = 'north' INTERSECT SELECT sku FROM sales WHERE region = 'south' ORDER BY sku"]
check["intersect", rows, list [map ["sku": "B1"], map ["sku": "B3"]]]

// ---------- WITH: name a query, then use it ----------
q = "WITH totals AS (SELECT sku, sum(qty) AS copies FROM sales GROUP BY sku) SELECT b.title, t.copies FROM books b JOIN totals t USING (sku) WHERE t.copies > 1 ORDER BY t.copies DESC"
rows = sql_query[db, q]
show table[rows] .
check["with", length of rows, 3]

// ---------- WITH RECURSIVE: every day of a week ----------
q = "WITH RECURSIVE d(day) AS (SELECT '2026-09-01' UNION ALL SELECT date(day, '+1 day') FROM d WHERE day < '2026-09-07') SELECT d.day, coalesce(sum(s.qty), 0) AS copies FROM d LEFT JOIN sales s ON s.day = d.day GROUP BY d.day ORDER BY d.day"
rows = sql_query[db, q]
show table[rows] .
check["seven days", length of rows, 7]
check["a quiet day", rows at get[1], map ["day": "2026-09-02", "copies": 0]]

// ---------- VALUES: rows without a table ----------
rows = sql_query[db, "SELECT column1 AS n, column2 AS word FROM (VALUES (1, 'one'), (2, 'two')) ORDER BY n DESC"]
check["values", rows at get[0], map ["n": 2, "word": "two"]]

drop_shop[db, path]
finish[]
