// 08_schema.turtle: changing the shape of a database: indexes, views,
// ALTER TABLE (add, rename, drop a column; rename a table), CREATE
// TABLE ... AS SELECT, and DROP.
import sql
import data
import system [scriptfolder]
import lib/verify [check, finish]
import lib/shop [make_shop, drop_shop]

path = "{scriptfolder[]}/work08.db"
db = make_shop[path]

// ---------- indexes ----------
sql_run[db, "CREATE INDEX sales_sku ON sales (sku)"]
sql_run[db, "CREATE UNIQUE INDEX books_title ON books (title COLLATE NOCASE)"]
safe
    sql_run[db, "INSERT INTO books (sku, title, price) VALUES ('X1', 'DUNE', 5)"]
handle [sql] e .
    check["unique index, ignoring case", message of e, "sql_run: UNIQUE constraint failed: books.title"]
safe [end]

// ---------- a view: a saved query that reads like a table ----------
sql_run[db, "CREATE VIEW best_sellers AS SELECT b.title, sum(s.qty) AS copies FROM sales s JOIN books b USING (sku) GROUP BY b.sku HAVING copies >= 4"]
rows = sql_query[db, "SELECT * FROM best_sellers ORDER BY copies DESC"]
show table[rows] .
check["view", length of rows, 2]

// ---------- ALTER TABLE ----------
sql_run[db, "ALTER TABLE books ADD COLUMN rating REAL DEFAULT 3.0"]
check["new column has its default", sql_query[db, "SELECT rating FROM books WHERE sku = 'B1'"], list [map ["rating": 3.0]]]
sql_run[db, "ALTER TABLE books RENAME COLUMN stock TO on_hand"]
sql_run[db, "ALTER TABLE sales RENAME TO orders"]
sql_run[db, "ALTER TABLE orders DROP COLUMN region"]
check["tables", sql_tables[db], list ["authors", "books", "orders"]]
rows = sql_query[db, "SELECT * FROM orders ORDER BY id LIMIT 2"]
show table[rows] .
check["dropped column is gone", rows at get[0] at getkeys[], list ["id", "sku", "day", "qty"]]
check["renamed column", sql_query[db, "SELECT on_hand FROM books WHERE sku = 'B6'"], list [map ["on_hand": 9]]]

// ---------- a table made from a query ----------
sql_run[db, "CREATE TABLE per_author AS SELECT a.name, count(b.sku) AS books FROM authors a LEFT JOIN books b ON b.author_id = a.id GROUP BY a.id"]
check["created from a query", length of sql_query[db, "SELECT * FROM per_author"], 5]

// ---------- what's in the schema ----------
rows = sql_query[db, "SELECT type, name FROM sqlite_schema WHERE name NOT LIKE 'sqlite_%' ORDER BY type, name"]
show table[rows] .

// ---------- DROP ----------
sql_run[db, "DROP VIEW best_sellers"]
sql_run[db, "DROP TABLE per_author"]
sql_run[db, "DROP INDEX sales_sku"]
sql_run[db, "DROP TABLE IF EXISTS no_such_table"]
check["after drops", sql_tables[db], list ["authors", "books", "orders"]]

drop_shop[db, path]
finish[]
