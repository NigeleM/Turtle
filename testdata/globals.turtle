// Functions can read globals. To change one, give the function the value
// and assign what it returns. A global list, set or map can be changed in
// place, and the change is seen after the call.

PI = 3.14159
count = 0
nums = list [1, 2, 3]

def circleArea[r]
    return PI * r * r
def [end]

def bump[n]
    return n + 1
def [end]

def addToNums[v]
    add v to nums .
def [end]

show circleArea[2] .

count = bump[count]
count = bump[count]
show count .

addToNums[99]
show nums .
