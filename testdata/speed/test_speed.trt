// ---------- databases ----------
def test_sqlite_create_insert_query[]
    path = "{here}/speed_work.db"
    if ] exists[path] [
        erase[path]
    if [end]
    db = sql_create[path]
    sql_run[db, "CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER)"]
    sql_run[db, "BEGIN"]
    [loop][i = 0; i < 100; i++]
        sql_run[db, "INSERT INTO t (n) VALUES (?)", list [i]]
    [loop][end]
    sql_run[db, "COMMIT"]
    rows = sql_query[db, "SELECT sum(n) AS s FROM t WHERE n > ?", list [10]]
    sql_close[db]
    erase[path]
def [end]

// ---------- the answers are right, too ----------
def test_answers[]
    benchmark = false
    check fib[15] == 610 .
    check min_sort[turtle_shuffle[numbers]] == min_sort[numbers] .
    check min_sort[shuffle[numbers]] == min_sort[numbers] .
def [end]
