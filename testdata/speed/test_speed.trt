def test_if_else_1k[]
    small = 0
    [loop][n in numbers]
        if ] n < 0 [
            small = small + 1
        else ]
            small = small - 1
        if [end]
    [loop][end]
def [end]

def test_closures_1k[]
    add5 = make_adder[5]
    [loop][i = 0; i < 1000; i++]
        x = add5[i]
    [loop][end]
def [end]

def test_safe_handle_100[]
    [loop][i = 0; i < 100; i++]
        safe
            x = 1 div 0
        handle [math] e .
            x = 0
        safe [end]
    [loop][end]
def [end]

