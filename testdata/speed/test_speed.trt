// test_speed.trt: how fast common Turtle work runs. Not a pass/fail check
// of speed: every test passes; the timings are for reading and comparing.
//
//     turtle test testdata/speed
//
// Each test is benchmarked (benchmark = true): Turtle runs it as many
// times as fit in benchtime and reports the average, fastest and slowest.
// Run it before and after a change to the interpreter to see if anything
// got slower. The Go tests run this file once with benchmark = false, to
// keep it working.
import test
import data
import strings
import math
import json
import sort [min_sort]
import search [find_first]
import random
import time [add_time, make_date]
import sql
import system [scriptFolder, erase, exists]

benchmark = true
benchtime = 0.2
seed = 1

assemble Order [item, qty, price]

numbers = random list of 1000 integers
words = random list of 1000 strings of 5
orders = random list of 100 Order [string, integer from 1 to 9, integer from 100 to 999]
ages = random map of 100 string of 6 to integer from 0 to 99
here = scriptFolder[]

def fib[n]
    if ] n < 2 [
        return n
    if [end]
    return fib[n - 1] + fib[n - 2]
def [end]

def make_adder[n]
    def adder[x]
        return x + n
    def [end]
    return adder
def [end]

// shuffle written in Turtle with put (Fisher-Yates): to compare with
// the random library's shuffle, written in Go.
def turtle_shuffle[items]
    out = change items to list
    [loop][i = length of out - 1; i > 0; i--]
        j = random integer from 0 to i
        a = out at get[i]
        put out at get[j] to out at i .
        put a to out at j .
    [loop][end]
    return out
def [end]

// ---------- calls and control ----------
def test_function_calls_fib_15[]
    x = fib[15]
def [end]

def test_loop_10k_additions[]
    total = 0
    [loop][i = 0; i < 10000; i++]
        total = total + i
    [loop][end]
def [end]

def test_for_each_1k[]
