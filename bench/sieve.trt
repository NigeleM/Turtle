// sieve: primes below 1,000,000 (list indexing and nested loops).
import time
best = 1000000000
[loop][r = 0; r < 3; r++]
    t = now[]
    n = 1000000
    flags = list []
    [loop][i = 0; i < n; i++]
        add true to flags .
    [loop][end]
    count = 0
    [loop][i = 2; i < n; i++]
        if ] flags at get[i] [
            count = count + 1
            [loop][j = i * i; j < n; j = j + i]
                put false to flags at j .
            [loop][end]
        if [end]
    [loop][end]
    took = now[] - t
    if ] took < best [
        best = took
    if [end]
[loop][end]
show "result=", count, " ms=", best .
