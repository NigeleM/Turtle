import time
// stdlib: each library function timed on the same data, best of 3. Sorting
// uses 200,000 numbers (insertion_sort 3,000: it's quadratic); statistics
// use 200,000; matrices are 150 x 150.
import linear
import data
import sort
import search
def make[n]
    out = list []
    x = 1
    [loop][i = 0; i < n; i++]
        x = x * 75 + 74
        x = x % 65537
        add x to out .
    [loop][end]
    return out
def [end]
nums = make[200000]
small = make[3000]
sorted_nums = quick_sort[nums]
mat = zeros[150, 150]
x = 1
[loop][r = 0; r < 150; r++]
    [loop][c = 0; c < 150; c++]
        x = x * 75 + 74
        x = x % 65537
        mat at put[x, r, c] .
    [loop][end]
[loop][end]
show "stdlib (ms, best of 3)" .
best = 1000000000
[loop][r = 0; r < 3; r++]
    t = now[]
    quick_sort[nums]
    took = now[] - t
    if ] took < best [
        best = took
    if [end]
[loop][end]
show "quick_sort", best .
best = 1000000000
[loop][r = 0; r < 3; r++]
