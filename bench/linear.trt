// linear.trt: how the linear library scales, and what it saves over
// the same arithmetic written as Turtle loops. Run it from this folder:
//
//     turtle linear.trt
//
// Each time is the best of 3, in milliseconds.

import time
import linear
import data
import math

// filled is an n x n matrix of numbers that keeps every operation well
// behaved: symmetric, with a large diagonal.
def filled[n]
    m = zeros[n]
    [loop][i = 0; i < n; i++]
        [loop][j = 0; j < n; j++]
            v = i * 7 + j * 7
            m = m at put[v % 10, i, j]
        [loop][end]
        m = m at put[n * 10, i, i]
    [loop][end]
    return m
def [end]

def best_of[f]
    best = 1000000000
    [loop][r = 0; r < 3; r++]
        t = now[]
        x = f[]
        took = now[] - t
        if ] took < best [
            best = took
        if [end]
    [loop][end]
    return best
def [end]

rows = list []
[loop][n in list [50, 100, 200, 400, 800]]
    m = filled[n]
    v = range[n]
    row = map ["n": n]
    row is row at add["build (put)", best_of[[] give filled[n]]] .
    row is row at add["multiply", best_of[[] give m * m]] .
    row is row at add["solve", best_of[[] give solve[m, v]]] .
    row is row at add["inverse", best_of[[] give inverse[m]]] .
    row is row at add["determinant", best_of[[] give determinant[m]]] .
    if ] n <= 800 [
        row is row at add["eigen", best_of[[] give eigen[m]]] .
        row is row at add["svd", best_of[[] give svd[m]]] .
    if [end]
    add row to rows .
    show "n = ", n, " done" .
[loop][end]
show table[rows] .

// The same product as Turtle loops over lists of lists.
def loop_multiply[a, b, n]
    out = list []
    [loop][i = 0; i < n; i++]
        row = list []
        ai = a at get[i]
        [loop][j = 0; j < n; j++]
            s = 0
            [loop][k = 0; k < n; k++]
                s = s + ai at get[k] * b at get[k] at get[j]
            [loop][end]
            add s to row .
        [loop][end]
        add row to out .
    [loop][end]
    return out
def [end]

compare = list []
[loop][n in list [50, 100]]
    m = filled[n]
    lists = change m to list
    by_lib = best_of[[] give m * m]
    by_loops = best_of[[] give loop_multiply[lists, lists, n]]
    same = change loop_multiply[lists, lists, n] to matrix == m * m
    add map ["n": n, "library ms": by_lib, "Turtle loops ms": by_loops, "same answer": same] to compare .
[loop][end]
show table[compare] .

nums = list []
[loop][i = 0; i < 1000000; i++]
    add i * 7919 % 1000 / 10 to nums .
[loop][end]
stat_rows = list []
[loop][name in list ["mean", "stdev", "median", "percentile", "describe"]]
    f = [] give mean[nums]
    if ] name == "stdev" [
        f = [] give stdev[nums]
    else if ] name == "median" [
        f = [] give median[nums]
    else if ] name == "percentile" [
        f = [] give percentile[nums, 90]
    else if ] name == "describe" [
        f = [] give describe[nums]
    if [end]
    add map ["statistic (1,000,000 numbers)": name, "ms": best_of[f]] to stat_rows .
[loop][end]
show table[stat_rows] .
