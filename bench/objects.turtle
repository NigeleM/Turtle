// objects: 200,000 small records made, then their fields read.
import time
assemble Point [x, y]
best = 1000000000
[loop][r = 0; r < 3; r++]
    t = now[]
    points = list []
    [loop][i = 0; i < 200000; i++]
        add Point[i, i + 1] to points .
    [loop][end]
    total = 0
    [loop][p in points]
        total = total + x of p * y of p % 1000
    [loop][end]
    took = now[] - t
    if ] took < best [
        best = took
    if [end]
[loop][end]
show "result=", total, " ms=", best .
