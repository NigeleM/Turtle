// run.trt: Turtle's benchmark. The same small programs in Turtle,
// Python, JavaScript (Node), Ruby and Go, each timing its own work (best
// of 3, startup not counted) and printing a checksum, so every language
// is checked to compute the same answer. Run it from this folder:
//
//     turtle run.trt
//
// It builds turtle from ../cmd/turtle first, skips languages this
// computer doesn't have, and writes RESULTS.md.

import time
import math
import data
import strings
import pattern
import schedule
import system

benchmarks = map [
    "fib": "recursive function calls: fib[27]",
    "loop": "a counting loop with arithmetic, 3,000,000 passes",
    "strings": "200,000 pieces of text built, joined, split",
    "lists": "300,000 numbers made, sorted, read",
    "maps": "200,000 keys put in a map, then looked up",
    "sieve": "primes below 1,000,000: list indexing in nested loops",
    "objects": "200,000 records (assembled values) made and read",
    "jsondata": "20,000 records to JSON text and back",
    "patterns": "a pattern (regex) over 50,000 lines",
    "functional": "process, keep, reduce over 300,000 numbers",
    "matrix": "a 200 x 200 matrix built, multiplied, and a 200 x 200 system solved (Turtle: import linear)",
    "stats": "mean, stdev, median, 90th percentile of 300,000 numbers (Turtle: import data; Python: statistics)"
]

def has[cmd]
    outs = runall[list ["command -v " + cmd]]
    return code of outs at get[0] == 0
def [end]

build = runall[list ["go build -o .turtle-bench ../cmd/turtle"]] at get[0]
if ] code of build != 0 [
    show "couldn't build turtle: ", errors of build .
    exit[1]
if [end]

languages = list [map ["name": "Turtle", "run": "./.turtle-bench NAME.trt", "hello": "./.turtle-bench hello.trt"]]
if ] has["python3"] [
    add map ["name": "Python", "run": "python3 -I NAME.py", "hello": "python3 -I hello.py"] to languages .
if [end]
if ] has["node"] [
    add map ["name": "Node", "run": "node NAME.js", "hello": "node hello.js"] to languages .
if [end]
if ] has["ruby"] [
    add map ["name": "Ruby", "run": "ruby NAME.rb", "hello": "ruby hello.rb"] to languages .
if [end]
if ] has["go"] [
    add map ["name": "Go", "run": "go run NAME.go", "hello": ""] to languages .
if [end]

// fill puts a benchmark's name into a command.
def fill[cmd, name]
    return replaceall[cmd, "NAME", name]
def [end]

// ms reads "result=... ms=..." from a run: [result, ms], or none.
def ms[out]
    parts = groups[out, `result=(\S+) ms=([0-9.]+)`]
    if ] parts == none [
        return none
    if [end]
    return list [parts at get[0], change parts at get[1] to float]
def [end]

rows = list []
mismatches = list []
[loop][name, about in benchmarks]
    show "running ", name, " ..." .
    row = map ["benchmark": name]
    want = none
    [loop][lang in languages]
        out = runall[list [fill[run of lang, name]]] at get[0]
        got = ms[output of out]
        if ] got == none [
            row is row at add[name of lang, "error"] .
            show "  ", name of lang, " failed: ", errors of out, output of out .
        else ]
            row is row at add[name of lang, got at get[1]] .
            if ] want == none [
                want = got at get[0]
            else if ] got at get[0] != want [
                add name + " (" + name of lang + ")" to mismatches .
            if [end]
        if [end]
    [loop][end]
    add row to rows .
[loop][end]

// Startup: how long "hello" takes from start to finish, best of 5.
startup = map ["benchmark": "startup (hello)"]
[loop][lang in languages]
    if ] hello of lang != "" [
        best = 1000000000
        [loop][i = 0; i < 5; i++]
            t = now[]
            x = runall[list [hello of lang]]
            took = now[] - t
            if ] took < best [
                best = took
            if [end]
        [loop][end]
        startup is startup at add[name of lang, best] .
    if [end]
[loop][end]
add startup to rows .

// The report: times in ms, and how many times slower Turtle is.
names = process[languages, l give name of l]
header = "| benchmark | " + join[names, " ms | "] + " ms |"
lines = list [header, "|" + join[process[range[0, length of names + 1], i give "---"], "|"] + "|"]
[loop][row in rows]
    cells = list [benchmark of row]
    [loop][n in names]
        if ] row at contains[n] [
            add "{row at get[n]}" to cells .
        else ]
            add "" to cells .
        if [end]
    [loop][end]
    add "| " + join[cells, " | "] + " |" to lines .
[loop][end]
table_text = join[lines, "\n"]

ratios = list ["| benchmark | Turtle ÷ " + join[names at slice[1], " | Turtle ÷ "] + " |", "|" + join[process[names, n give "---"], "|"] + "|"]
[loop][row in rows]
    cells = list [benchmark of row]
    [loop][n in names at slice[1]]
        tt = row at get["Turtle"]
        if ] row at contains[n] && typeof[tt] != "string" [
            other = row at get[n]
            if ] typeof[other] != "string" && other > 0 [
                q = tt / other
                places = 1
                if ] q < 1 [
                    places = 2 // faster than the other: 0.05x, not 0.0x
                if [end]
                add "{q at round[places]}x" to cells .
            else ]
                add "" to cells .
            if [end]
        else ]
            add "" to cells .
        if [end]
    [loop][end]
    add "| " + join[cells, " | "] + " |" to ratios .
[loop][end]
ratio_text = join[ratios, "\n"]

show "" .
show table_text .
show "" .
show ratio_text .
if ] length of mismatches > 0 [
    show "results differ: ", mismatches .
if [end]

about_lines = list []
[loop][name, about in benchmarks]
    add "- **{name}**: {about}" to about_lines .
[loop][end]
versions = runall[list ["./.turtle-bench version", "python3 --version", "node --version", "ruby --version", "go version", "uname -sm"]]
report = "# Turtle benchmark results

Made by `turtle run.trt` in this folder on " + format_date[today[], "YYYY-MM-DD"] + ".
Times are milliseconds: each program times its own work, best of 3 runs,
so starting the language isn't counted (startup is measured on its own,
from start to finish). Every language computes the same answer, checked.

" + table_text + "

How many times slower Turtle is than each (1.0x is the same speed; under
1.0x, Turtle is faster):

" + ratio_text + "

What each one does:

" + join[about_lines, "\n"] + "

Versions: " + join[process[versions, v give output of v], "; "] + "
"
[write] RESULTS.md
report
[end]
erase[".turtle-bench"]
show "" .
show "wrote RESULTS.md" .
