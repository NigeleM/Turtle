// search: a sorted list of 300,000 even numbers, and 300,000 lookups of
// keys from a small formula, each found by binary search. Counts the hits.
import time
best = 1000000000
[loop][r = 0; r < 3; r++]
    t = now[]
    nums = list []
    [loop][i = 0; i < 300000; i++]
        add i * 2 to nums .
    [loop][end]
    found = 0
    x = 1
    [loop][q = 0; q < 300000; q++]
        x = x * 75 + 74
        x = x % 600001
        lo = 0
        hi = 299999
        [loop][lo <= hi]
            s = lo + hi
            mid = s div 2
            v = nums at get[mid]
            if ] v == x [
                found = found + 1
                lo = hi + 1
            else if ] v < x [
                lo = mid + 1
            else ]
                hi = mid - 1
            if [end]
        [loop][end]
    [loop][end]
    took = now[] - t
    if ] took < best [
        best = took
    if [end]
[loop][end]
show "result=", found, " ms=", best .
