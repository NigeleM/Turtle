{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Turtle",
  "scopeName": "source.turtle",
  "fileTypes": [
    "trt"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#library"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#sentences"
    },
    {
      "include": "#libraryWords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.turtle",
          "begin": "//\\*",
          "end": "\\*//"
        },
        {
          "name": "comment.line.double-slash.turtle",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.turtle",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.double.turtle",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.turtle",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.turtle",
      "match": "\\\\[nt\"'\\\\{}]"
    },
    "interpolation": {
      "name": "meta.interpolation.turtle",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.turtle"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.turtle"
        }
      },
      "patterns": [
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#calls"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.turtle"
            },
            "2": {
              "name": "entity.name.function.turtle"
            }
          }
        },
        {
          "match": "\\b(assemble)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.turtle"
            },
            "2": {
              "name": "entity.name.type.turtle"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.turtle",
          "match": "\\b(if|else|loop|end|return|break|continue|safe|handle|fail|import)\\b"
        },
        {
          "name": "keyword.other.turtle",
          "match": "\\b(add|append|assemble|at|change|def|delete|directory|div|from|give|in|insert|is|length|list|map|max|min|of|read|remove|reverse|set|show|sort|sys|to|warn|write)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.turtle",
      "match": "\\b(true|false|none)\\b"
    },
    "numbers": {
      "name": "constant.numeric.turtle",
      "match": "\\b\\d+(\\.\\d+)?\\b|(?<![\\w.])\\.\\d+\\b"
    },
    "library": {
      "name": "support.function.turtle",
      "match": "\\b(add_time|args|binary_search|bubble_sort|chance|contents|copy|copyto|count_where|counting_sort|env|erase|every|exists|exit|exponential_search|find|find_all|find_first|find_index|find_key|find_last|findall|format_date|groups|heap_sort|http_get|http_post|http_request|insert_position|insertion_sort|interpolation_search|is_sorted|isfile|isfolder|isinstring|join|json_get|json_read|json_text|json_write|jump_search|keep|linear_search|load|loadenv|make_date|makefolder|matches|max_sort|merge_sort|min_sort|moveto|now|options|pack|pick|process|quick_sort|radix_sort|range|reduce|replaceall|reverse_list|sample|scriptfolder|selection_sort|shell_sort|shuffle|sleep|splitby|sql_close|sql_create|sql_delete|sql_load|sql_open|sql_query|sql_run|sql_save|sql_tables|sql_update|sql_upsert|substring|sum|table|table_read|table_write|ternary_search|time_between|to_date|today|today_utc|unpack|wait_until|walk|warn)(?=\\[)"
    },
    "calls": {
      "name": "entity.name.function.call.turtle",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\[)"
    },
    "libraryWords": {
      "name": "keyword.other.library.turtle",
      "match": "^\\s*(check|verify|validate|log)\\b|\\brandom(?=\\s+(integer|float|string|digits?|letter|boolean|date|time|list|set|map|[A-Z]))|(?<=[\\w\\]\\)\"] )type(?=\\s+[A-Za-z])"
    },
    "sentences": {
      "name": "support.function.turtle",
      "match": "(?<=[\\w\\]\\)\"'`] )(process|keep|copy|reduce|range|sum)\\b(?![\\[=])"
    }
  }
}
