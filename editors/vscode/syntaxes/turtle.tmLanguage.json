{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Turtle",
  "scopeName": "source.turtle",
  "fileTypes": [
    "turtle",
    "trt"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#theories"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#library"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#sentences"
    },
    {
      "include": "#libraryWords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.turtle",
          "begin": "//\\*",
          "end": "\\*//"
        },
        {
          "name": "comment.line.double-slash.turtle",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.turtle",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.double.turtle",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.turtle",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.turtle",
      "match": "\\\\[nt\"'\\\\{}]"
    },
    "interpolation": {
      "name": "meta.interpolation.turtle",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.turtle"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.turtle"
        }
      },
      "patterns": [
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#calls"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(def)\\s+(~?[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.turtle"
            },
            "2": {
              "name": "entity.name.function.turtle"
            }
          }
        },
        {
          "match": "\\b(assemble)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.turtle"
            },
            "2": {
              "name": "entity.name.type.turtle"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.turtle",
          "match": "\\b(if|else|loop|end|return|break|continue|safe|handle|fail|import)\\b"
        },
        {
          "name": "keyword.other.turtle",
          "match": "\\b(add|append|assemble|at|change|def|delete|directory|div|from|give|in|insert|is|length|list|map|max|min|of|read|remove|reverse|scroll|set|show|sort|sys|to|warn|write)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.turtle",
      "match": "\\b(true|false|none)\\b"
    },
    "numbers": {
      "name": "constant.numeric.turtle",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b|(?<![\\w.])\\.\\d+\\b"
    },
    "library": {
      "name": "support.function.turtle",
      "match": "\\b(add_time|args|binary_search|bubble_sort|chance|column|config_read|config_write|contents|copy|copyto|correlation|count_where|counting_sort|covariance|cross|decode|decrypt|describe|determinant|diagonal|dot|eigen|encode|encrypt|env|erase|every|exists|exit|exponential_search|fetchall|filehash|find|find_all|find_first|find_index|find_key|find_last|findall|flatten|format_date|freememory|groups|hash|heap_sort|hmac|http_get|http_post|http_request|identity|insert_position|insertion_sort|interpolation_search|inverse|is_sorted|isfile|isfolder|isinstring|join|json_get|json_read|json_text|json_write|jump_search|keep|least_squares|linear_search|load|loadenv|lu|make_date|makefolder|matches|max_sort|mean|median|memory|merge_sort|min_sort|mode|moveto|multiply_each|norm|now|ones|options|pack|passwordcheck|passwordhash|percentile|pick|power|process|pstdev|pvariance|qr|queryall|quick_sort|radix_sort|range|rank|redirect|reduce|replaceall|reply|reshape|reverse_list|row|runall|sample|scriptfolder|selection_sort|serve|shape|shell_sort|shuffle|sizeof|sleep|solve|splitby|sql_close|sql_create|sql_delete|sql_load|sql_open|sql_query|sql_run|sql_save|sql_tables|sql_update|sql_upsert|stdev|substring|sum|svd|table|table_read|table_write|ternary_search|time_between|to_date|to_zone|today|today_utc|token|trace|transpose|unit|unpack|uuid|variance|wait_until|walk|warn|zeros|zscores)(?=\\[)"
    },
    "calls": {
      "name": "entity.name.function.call.turtle",
      "match": "~?\\b[A-Za-z_][A-Za-z0-9_]*(?=\\[)"
    },
    "libraryWords": {
      "name": "keyword.other.library.turtle",
      "match": "^\\s*(check|verify|validate|log)\\b|\\brandom(?=\\s+(integer|float|string|digits?|letter|boolean|date|time|list|set|map|[A-Z]))|(?<=[\\w\\]\\)\"] )type(?=\\s+[A-Za-z])|\\bmatrix(?=\\s*\\[)|\\bhypothesis(?=\\[)"
    },
    "sentences": {
      "name": "support.function.turtle",
      "match": "(?<=[\\w\\]\\)\"'`] )(process|keep|copy|reduce|range|sum)\\b(?![\\[=])"
    },
    "theories": {
      "patterns": [
        {
          "comment": "theory tally ... theory [end]",
          "match": "^\\s*(theory)\\s+(~?[A-Za-z_][A-Za-z0-9_]*)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.control.turtle"
            },
            "2": {
              "name": "entity.name.function.turtle"
            }
          }
        },
        {
          "match": "^\\s*(theory)\\s*(\\[end\\])",
          "captures": {
            "1": {
              "name": "keyword.control.turtle"
            },
            "2": {
              "name": "keyword.control.turtle"
            }
          }
        },
        {
          "comment": "a theory's sections, not the same words used as names (proof = 5)",
          "match": "^\\s*(abstract|notation|definition|theorem|proof)\\b(?!\\s*(=|is\\b|at\\b|of\\b|\\[))",
          "captures": {
            "1": {
              "name": "keyword.control.turtle"
            }
          }
        }
      ]
    }
  }
}
